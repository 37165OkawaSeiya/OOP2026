<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="天気予報"
        Height="740"
        Width="660"
        MinHeight="640"
        MinWidth="560"
        Background="#F4F6F9">

    <Grid Margin="20">
        <!-- 最大化しても横幅が広がりすぎないよう中央コンテナで制御 -->
        <Grid MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ヘッダーと更新ボタン -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Content="更新"
                        Width="96"
                        Height="38"
                        VerticalAlignment="Center"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RefreshButton_Click" />

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLocationTextBlock"
                               Text="東京の天気予報"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E293B" />
                    <TextBlock x:Name="StatusTextBlock"
                               Text="起動時に取得します..."
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 都市選択とカスタム緯度・経度エリア -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 都市プリセット選択 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="都市を選択:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="CityComboBox"
                                  Grid.Column="1"
                                  Height="34"
                                  FontSize="13"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CityComboBox_SelectionChanged" />
                    </Grid>

                    <!-- カスタム緯度・経度入力（折り返し＆幅固定で最大化でも崩れない） -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="場所名:"
                                   FontSize="12"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,4" />
                        <TextBox x:Name="CustomNameTextBox"
                                 Width="105"
                                 Height="30"
                                 Padding="6,2"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,4" />

                        <TextBlock Text="緯度:"
                                   FontSize="12"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,4" />
                        <TextBox x:Name="LatitudeTextBox"
                                 Width="86"
                                 Height="30"
                                 Padding="6,2"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,4" />

                        <TextBlock Text="経度:"
                                   FontSize="12"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,4" />
                        <TextBox x:Name="LongitudeTextBox"
                                 Width="92"
                                 Height="30"
                                 Padding="6,2"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,4" />

                        <Button x:Name="FetchCustomButton"
                                Content="座標で取得"
                                Height="30"
                                Padding="14,0"
                                Background="#0F172A"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,4"
                                Click="FetchCustomButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 現在の天気カード -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="現在の天気"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B" />
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,4" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentWeatherIconTextBlock"
                                       Text="☀️"
                                       FontSize="42"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <TextBlock x:Name="CurrentTempTextBlock"
                                       Text="--.-℃"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <TextBlock x:Name="CurrentWeatherTextBlock"
                                       Text="取得中..."
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB"
                                       VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="16,12"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="CurrentHumidityTextBlock"
                                       Text="湿度: --%"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#334155"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="CurrentWindTextBlock"
                                       Text="風速: --.- m/s"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#334155" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 7日間予報エリア -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="7日間の予報"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12" />

                    <DataGrid Grid.Row="1"
                              x:Name="ForecastDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              Background="White"
                              AlternatingRowBackground="#FAFCFF"
                              BorderThickness="0"
                              RowHeight="42"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    VerticalAlignment="Center">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding DateText}" Width="1.1*" MinWidth="105" />
                            <DataGridTextColumn Header="天気" Binding="{Binding WeatherIcon}" Width="0.7*" MinWidth="60" FontSize="18" />
                            <DataGridTextColumn Header="天気詳細" Binding="{Binding WeatherText}" Width="1.6*" MinWidth="120" />
                            <DataGridTextColumn Header="最高"
                                                Binding="{Binding MaxTemperature, StringFormat={}{0:0.0}℃}"
                                                Foreground="{Binding MaxTempBrush}"
                                                FontWeight="SemiBold"
                                                Width="0.9*"
                                                MinWidth="82" />
                            <DataGridTextColumn Header="最低"
                                                Binding="{Binding MinTemperature, StringFormat={}{0:0.0}℃}"
                                                Foreground="{Binding MinTempBrush}"
                                                FontWeight="SemiBold"
                                                Width="0.9*"
                                                MinWidth="82" />
                            <DataGridTextColumn Header="降水確率"
                                                Binding="{Binding PrecipitationProbability, StringFormat={}{0}%}"
                                                Width="1*"
                                                MinWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>